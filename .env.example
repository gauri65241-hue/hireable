# Copy to .env — never commit .env

# Data files
RESUMES_CSV=data/resumes.csv
JOBS_CSV=data/jobs.csv
SKILLS_TAXONOMY=data/skills_taxonomy.json
LABELS_CSV=data/labels.csv
MONITORING_CSV=monitoring.csv

# Experiment tracking, used by the optional evaluate command
WANDB_API_KEY=your_wandb_api_key_here

# LLM provider for dashboard analysis.
# Preferred names for the current OpenRouter-compatible implementation:
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=openrouter/free

# Backward-compatible aliases still supported by linkedin_api.py:
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_MODEL=openrouter/free

# --- Security / operations (see README "Hardening") ---
# Comma-separated emails allowed to call /benchmark-* (empty = those routes are disabled)
ADMIN_EMAILS=
# Needed once to register an ADMIN_EMAILS address (otherwise those addresses are reserved, so a stranger
# cannot pre-register your admin email). Send it as `bootstrap_token` in POST /auth/register, then remove it.
ADMIN_BOOTSTRAP_TOKEN=
# Number of reverse proxies you control in front of the app (Render: 1). 0 = ignore X-Forwarded-For.
TRUSTED_PROXY_COUNT=0
# Optional allow-list for user-supplied LLM base URLs, e.g. openrouter.ai,api.openai.com
ALLOWED_API_HOSTS=
# Where mutable state lives (DB, feedback, JWT secret). Mount persistent volumes HERE, not on ./data
HIREABLE_STATE_DIR=
# Upload / fetch limits
MAX_PDF_BYTES=5242880
MAX_PDF_PAGES=30
# Result-cache lifetime in days
SCORE_CACHE_TTL_DAYS=30
