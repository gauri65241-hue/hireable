# Copy to .env — never commit .env

# Data files
RESUMES_CSV=data/resumes.csv
JOBS_CSV=data/jobs.csv
SKILLS_TAXONOMY=data/skills_taxonomy.json
LABELS_CSV=data/labels.csv
MONITORING_CSV=monitoring.csv

# Experiment tracking, used by the optional evaluate command
WANDB_API_KEY=your_wandb_api_key_here

# LLM provider for dashboard analysis.
# Preferred names for the current OpenRouter-compatible implementation:
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=openrouter/free

# Backward-compatible aliases still supported by linkedin_api.py:
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_MODEL=openrouter/free
